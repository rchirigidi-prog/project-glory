<?php

session_start();

if(!isset($_SESSION['prayer_admin'])) {

    header("Location: login.php");

    exit;

}

?>

<?php

$file = __DIR__ . '/../storage/prayers.json';

$prayers = [];

if (file_exists($file)) {

    $prayers = json_decode(
        file_get_contents($file),
        true
    ) ?: [];

}

$prayers = array_reverse($prayers);

foreach($prayers as &$prayer) {

    if(!isset($prayer['status'])) {

        $prayer['status'] = 'New';

    }

}

$totalRequests = count($prayers);

?>

<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Prayer Requests Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{
    background:#0b2345;
    color:#fff;
    padding:40px 0;
}

.card{
    background:#16345f;
    border:none;
    border-radius:20px;
}

.table th{
    background:#ffc107;
    color:#000;
}

.table td{
    vertical-align:middle;
}

.badge-total{
    background:#ffc107;
    color:#000;
    padding:10px 20px;
    border-radius:30px;
    font-weight:600;
}

.request-box{
    max-width:450px;
    white-space:normal;
}

.header-actions{
    display:flex;
    gap:10px;
    align-items:center;
}

</style>

</head>

<body>

<div class="container">

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">
        🙏 Prayer Requests Dashboard
    </h1>

    <div class="header-actions">

<span class="badge-total">
    Total Requests:
    <?php echo $totalRequests; ?>
</span>

<a
    href="../api/export-prayers.php"
    class="btn btn-warning">

    📥 Export CSV

</a>

<a
    href="logout.php"
    class="btn btn-danger">

    🚪 Logout

</a>

</div>


</div>

<div class="card p-4">

    <div class="mb-3">

        <input
            type="text"
            id="searchInput"
            class="form-control"
            placeholder="Search by Name, Email or Prayer Request">

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover bg-white">

            <thead>

                <tr>

                    <th>Date</th>

                    <th>Name</th>

                    <th>Email</th>

                    <th>Prayer Request</th>

                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

            <?php foreach($prayers as $prayer): ?>

                <tr>

                    <td>
                        <?php echo htmlspecialchars($prayer['date'] ?? ''); ?>
                    </td>

                    <td>
                        <?php echo htmlspecialchars($prayer['name'] ?? ''); ?>
                    </td>

                    <td>
                        <?php echo htmlspecialchars($prayer['email'] ?? ''); ?>
                    </td>

                    <td>

                        <?php

                        $status = $prayer['status'] ?? 'New';

                         if($status == 'New') {

                         echo '<span class="badge bg-warning text-dark">🟡 New</span>';

                            }
                        elseif($status == 'In Prayer') {

                        echo '<span class="badge bg-primary">🔵 In Prayer</span>';

                        }
                        else {

                            echo '<span class="badge bg-success">🟢 Prayed</span>';

                            }

                            ?>

                    </td>

                </tr>

            <?php endforeach; ?>

            </tbody>

        </table>

    </div>

</div>


</div>

<script>

document
.getElementById("searchInput")
.addEventListener("keyup", function() {

    let filter =
    this.value.toLowerCase();

    let rows =
    document.querySelectorAll("tbody tr");

    rows.forEach(row => {

        let text =
        row.innerText.toLowerCase();

        row.style.display =
        text.includes(filter)
        ? ""
        : "none";

    });

});

</script>

</body>

</html>

</div>

<div class="modal fade" id="viewPrayerModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header bg-warning">

                <h5 class="modal-title">

                    🙏 Prayer Request

                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <table class="table">

                    <tr>

                        <th width="150">Name</th>

                        <td id="modalName"></td>
                    </tr>

                    <tr>

                        <th>Email</th>

                        <td id="modalEmail"></td>

                    </tr>

                    <tr>

                        <th>Status</th>

                        <td id="modalStatus"></td>

                    </tr>

                    <tr>

                        <th>Date</th>

                        <td id="modalDate"></td>

                    </tr>

                    <tr>

                        <th>Prayer</th>

                        <td id="modalRequest"></td>

                    </tr>

                </table>

            </div>

        </div>

    </div>

</div>


<script>

document.addEventListener('DOMContentLoaded', function () {

    const buttons = document.querySelectorAll('.viewPrayer');

    console.log("Buttons Found:", buttons.length);

    buttons.forEach(btn => {

        btn.addEventListener('click', function () {

            console.log("VIEW BUTTON CLICKED");

            document.getElementById('modalName').innerText = btn.dataset.name;
            document.getElementById('modalEmail').innerText = btn.dataset.email;
            document.getElementById('modalStatus').innerText = btn.dataset.status;
            document.getElementById('modalDate').innerText = btn.dataset.date;
            document.getElementById('modalRequest').innerText = btn.dataset.request;

            const modal = new bootstrap.Modal(
                document.getElementById('viewPrayerModal')
            );

            modal.show();

        });

    });

});

</script>
<script>

document.getElementById('prayerSearch')
.addEventListener('keyup', function() {

    let value = this.value.toLowerCase();

    let rows = document.querySelectorAll('tbody tr');

    rows.forEach(row => {

        row.style.display =
            row.innerText.toLowerCase().includes(value)
            ? ''
            : 'none';

    });

});

</script>
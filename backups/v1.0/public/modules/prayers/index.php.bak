                <?php

                require_once __DIR__ . '/../../includes/helpers/prayer-helper.php';

                $file = __DIR__ . '/../../storage/prayers.json';

                $prayers = loadPrayers($file);

                savePrayers($file, $prayers);

                $prayers = array_reverse($prayers);

                if (!empty($prayers)) { 

                    $prayers = json_decode(file_get_contents($file), true);

                    $prayers = array_reverse($prayers);

                    foreach($prayers as $prayer){

                        $status = $prayer['status'] ?? 'New';

                        $badge = 'warning';

                        if($status == 'In Prayer') {
                            $badge = 'primary';
                        }

                        if($status == 'Completed') {
                            $badge = 'success';
                        }

                        ?>

                        <tr>

                            <td>
                                <?= htmlspecialchars($prayer['name'] ?? '') ?>
                            </td>

                            <td>
                                <?= htmlspecialchars($prayer['email'] ?? '') ?>
                            </td>

                            <td>
                                <?= htmlspecialchars($prayer['request'] ?? '') ?>
                            </td>

                            <td>
                                <?= htmlspecialchars($prayer['date'] ?? '') ?>
                            </td>

                            <td>

                                <span class="badge bg-<?= $badge ?>">

                                    <?= $status ?>

                                </span>

                            </td>

                            <td>

                                <button
                                        class="btn btn-sm btn-info viewPrayer"

                                        data-name="<?= htmlspecialchars($prayer['name'] ?? '') ?>"

                                        data-email="<?= htmlspecialchars($prayer['email'] ?? '') ?>"

                                        data-request="<?= htmlspecialchars($prayer['request'] ?? '') ?>"

                                        data-date="<?= htmlspecialchars($prayer['date'] ?? '') ?>"

                                        data-status="<?= htmlspecialchars($prayer['status'] ?? 'New') ?>">

                                        👁

                                </button>

                                <button
                                    class="btn btn-sm btn-success editPrayer"
                                    data-id="<?= $prayer['id'] ?>">

                                     ✏

                                </button>

                                <button
                                    class="btn btn-sm btn-danger deletePrayer"
                                    data-id="<?= $prayer['id'] ?>">

                                     🗑

                                </button>

                            </td>

                        </tr>

                        <?php
                    }
                }

                ?>

                </tbody>

            </table>

        </div>

